{
  "name": "svg-to-3d",
  "version": "0.4.0",
  "description": "Turn an SVG into watertight, multi-color 3D-printable solids, or a word into a stained-glass sign. Manifold-correct 3MF out, no repair round-trip.",
  "keywords": [
    "svg",
    "3mf",
    "3d-printing",
    "extrude",
    "manifold",
    "watertight",
    "mesh",
    "three",
    "multi-color",
    "stained-glass"
  ],
  "license": "MIT",
  "author": "Andrew Hunt <andrew@hunt.codes> (https://hunt.codes)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amhunt/svg-to-3d.git"
  },
  "homepage": "https://github.com/amhunt/svg-to-3d#readme",
  "bugs": "https://github.com/amhunt/svg-to-3d/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stained-glass": {
      "types": "./dist/stainedGlass/index.d.ts",
      "default": "./dist/stainedGlass/index.js"
    },
    "./stained-glass/prompt": {
      "types": "./dist/stainedGlass/prompt.d.ts",
      "default": "./dist/stainedGlass/prompt.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --import ./test/setup.js --test test/*.test.js && node --test test/stainedGlass.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "clipper2-ts": "2.0.1-19",
    "earcut": "^3.0.2",
    "jszip": "^3.10.1",
    "polygon-clipping": "^0.15.7"
  },
  "peerDependencies": {
    "three": ">=0.185.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.0.0",
    "@types/earcut": "^3.0.0",
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.10.1",
    "three": "^0.185.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
